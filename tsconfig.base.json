{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "baseUrl": ".",
    "paths": {
      "@operit/shared": ["packages/shared/src"],
      "@operit/tool-registry": ["packages/tool-registry/src"],
      "@operit/character-engine": ["packages/character-engine/src"],
      "@operit/agent-runtime": ["packages/agent-runtime/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}
